<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260312-1" author="trickcode">
        <createTable tableName="pro_subscription">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="plan_type" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="true"/>
            </column>
            <column name="order_id" type="bigint">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="pro_subscription" baseColumnNames="user_id"
            referencedTableName="jhi_user" referencedColumnNames="id"
            constraintName="fk_pro_sub_user"/>

        <addForeignKeyConstraint
            baseTableName="pro_subscription" baseColumnNames="order_id"
            referencedTableName="jhi_order" referencedColumnNames="id"
            constraintName="fk_pro_sub_order"/>

        <createIndex tableName="pro_subscription" indexName="idx_pro_sub_user_status">
            <column name="user_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>

    <!-- Add subscription_type column to jhi_order for subscription orders -->
    <changeSet id="20260312-2" author="trickcode">
        <addColumn tableName="jhi_order">
            <column name="subscription_type" type="varchar(30)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
